<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

    <Button
            android:id="@+id/button_open_webview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open WebView"
            android:layout_centerInParent="true" />
    <TextView
            android:id="@+id/random_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/button_open_webview"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true" />
    <TextView
            android:id="@+id/return_uri_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/random_text_view"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            android:text="Return URI will be shown here" />
</RelativeLayout>